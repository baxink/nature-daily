{
  "name": "nature-daily",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nature 七版面每日摘要",
  "scripts": {
    "dev:worker": "cd worker && npm run dev",
    "deploy:worker": "cd worker && npm run deploy",
    "db:init": "cd worker && npm run db:init",
    "db:seed": "cd worker && npm run db:seed",
    "test:docs": "node --test docs/app.test.mjs",
    "test": "npm run test:docs && npm --prefix worker test",
    "typecheck": "cd worker && npx tsc --noEmit"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
