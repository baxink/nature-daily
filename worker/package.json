{
  "name": "nature-daily-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute nature-daily-db --file=../db/schema.sql --remote",
    "db:seed": "wrangler d1 execute nature-daily-db --file=../db/seed.sql --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240405.0",
    "typescript": "^5.4.0",
    "wrangler": "^3.40.0"
  }
}
